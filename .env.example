# Server Configuration
PORT=8081

# MongoDB Configuration
# For Render deployment, use a MongoDB Atlas connection string:
# mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/jobtracker

# JSearch API Key (RapidAPI)
# Get a key from: https://rapidapi.com/letscrape-6552-letscrape-default/api/jsearch
JSEARCH_API_KEY=your_jsearch_api_key_here

# Gemini API Key (Google AI Studio)
# Get a key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
